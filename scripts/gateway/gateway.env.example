# Local secrets for credentialed gateway UPnP toggle (NEVER commit).
# Copy to: ~/.config/rohomieo/gateway.env  and chmod 600
#
# GATEWAY_URL=https://192.168.1.1
# GATEWAY_USER=admin
# GATEWAY_PASS=
#
# Preferred: paste "Copy as cURL" from DevTools after enabling UPnP once.
# Replace the real password with __GATEWAY_PASS__ and cookie/session if needed.
# GATEWAY_APPLY_CURL='curl -k ... -d "upnp_enable=1" ...'
GATEWAY_URL=https://192.168.1.1
GATEWAY_USER=admin
GATEWAY_PASS=
GATEWAY_APPLY_CURL=
